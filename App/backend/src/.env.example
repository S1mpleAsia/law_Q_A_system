# Copy to App/backend/src/.env and fill in. Shared by the backend, the Celery worker and the notebooks in Core/.

# MongoDB Atlas: parent chunks (database "law") and the knowledge graph
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
LAW_DOC_DB=law
# MongoDB for chat history (database "final_project"); can be the same cluster as MONGODB_URL
MONGODB_ADMIN_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/

# Qdrant Cloud: child chunks; the graph uses <COLLECTION_NAME>_entities and <COLLECTION_NAME>_relations
QDRANT_URL=https://<cluster-id>.<region>.cloud.qdrant.io:6333
QDRANT_API_KEY=
COLLECTION_NAME=law_collection

# Gemini: query rewrite, answer generation and knowledge graph extraction
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# BGE-M3 embeddings through an OpenAI-compatible API (Cloudflare Workers AI)
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<account-id>/ai/v1
EMBEDDING_MODEL=@cf/baai/bge-m3

# Pinecone inference: reranking with bge-reranker-v2-m3
PINECONE_API_KEY=

# Tavily web search, used when a question is outside the law corpus (required: imported at startup)
TAVILY_API_KEY=

# Redis for Celery
CELERY_BROKER_URL=redis://localhost:6379
CELERY_RESULT_BACKEND=redis://localhost:6379

# Default for the knowledge-graph toggle when a request does not set it
ENABLE_GRAPH_RETRIEVAL=true
